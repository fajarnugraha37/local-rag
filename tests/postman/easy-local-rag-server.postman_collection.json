{
  "info": {
    "name": "Easy Local RAG Server",
    "description": "Comprehensive Postman collection for FastAPI server mode (legacy compatibility + v1 APIs).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "4c4b8a70-2f33-4f01-b090-c1f9d9a1b2a9"
  },
  "item": [
    {
      "name": "System",
      "item": [
        {"name": "Health", "request": {"method": "GET", "url": "{{baseUrl}}/health"}},
        {"name": "Healthz", "request": {"method": "GET", "url": "{{baseUrl}}/healthz"}},
        {"name": "Readyz", "request": {"method": "GET", "url": "{{baseUrl}}/readyz"}},
        {"name": "Version", "request": {"method": "GET", "url": "{{baseUrl}}/version"}},
        {"name": "Capabilities", "request": {"method": "GET", "url": "{{baseUrl}}/v1/capabilities"}},
        {"name": "Config GET", "request": {"method": "GET", "url": "{{baseUrl}}/v1/config"}},
        {
          "name": "Config PATCH",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"updates\": {\n    \"top_k\": 6,\n    \"enable_streaming\": true\n  }\n}"},
            "url": "{{baseUrl}}/v1/config"
          }
        },
        {"name": "Swagger UI", "request": {"method": "GET", "url": "{{baseUrl}}/api/docs"}},
        {"name": "ReDoc", "request": {"method": "GET", "url": "{{baseUrl}}/api/redoc"}}
      ]
    },
    {
      "name": "Legacy Compatibility",
      "item": [
        {"name": "Actions", "request": {"method": "GET", "url": "{{baseUrl}}/actions"}},
        {"name": "Action Alias", "request": {"method": "GET", "url": "{{baseUrl}}/action"}},
        {
          "name": "Actions Run",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"action\": \"query\",\n  \"args\": [\"--help\"]\n}"},
            "url": "{{baseUrl}}/actions/run"
          }
        },
        {
          "name": "Action Run Alias",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"action\": \"query\",\n  \"args\": [\"--help\"]\n}"},
            "url": "{{baseUrl}}/action/run"
          }
        },
        {"name": "Docs List", "request": {"method": "GET", "url": "{{baseUrl}}/docs?limit=20"}},
        {"name": "Docs Delete", "request": {"method": "DELETE", "url": "{{baseUrl}}/docs/{{doc_id}}?namespace={{namespace}}"}},
        {
          "name": "Chat Stream SSE",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "text/event-stream"}],
            "url": "{{baseUrl}}/chat/stream?question={{question}}&top_k={{top_k}}"
          }
        },
        {
          "name": "Ingest Chunks",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"chunks\": [\"alpha\", \"beta\"],\n  \"doc_id\": \"postman_doc_legacy_chunks\",\n  \"source_path\": \"postman/legacy\",\n  \"namespace\": \"{{namespace}}\"\n}"},
            "url": "{{baseUrl}}/ingest/chunks"
          }
        },
        {
          "name": "Ingest Text",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"text\": \"payment due in 14 days\",\n  \"doc_id\": \"postman_doc_legacy_text\",\n  \"source_path\": \"postman/legacy\",\n  \"namespace\": \"{{namespace}}\"\n}"},
            "url": "{{baseUrl}}/ingest/text"
          }
        },
        {
          "name": "Ingest Files",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"paths\": [\"README.md\"],\n  \"recursive\": false,\n  \"namespace\": \"{{namespace}}\"\n}"},
            "url": "{{baseUrl}}/ingest/files"
          }
        },
        {
          "name": "Ingestion Files Alias",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"paths\": [\"README.md\"],\n  \"recursive\": false,\n  \"namespace\": \"{{namespace}}\"\n}"},
            "url": "{{baseUrl}}/ingestion/files"
          }
        },
        {
          "name": "Ingest Folder JSON",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"path\": \".\",\n  \"dry_run\": true,\n  \"stream\": false,\n  \"namespace\": \"{{namespace}}\"\n}"},
            "url": "{{baseUrl}}/ingest/folder"
          }
        },
        {
          "name": "Ingest Folder SSE",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "text/event-stream"}],
            "body": {"mode": "raw", "raw": "{\n  \"path\": \".\",\n  \"dry_run\": true,\n  \"stream\": true,\n  \"request_id\": \"postman-req-1\",\n  \"namespace\": \"{{namespace}}\"\n}"},
            "url": "{{baseUrl}}/ingest/folder"
          }
        },
        {
          "name": "Ingest Upload",
          "request": {
            "method": "POST",
            "body": {"mode": "formdata", "formdata": [{"key": "file", "type": "file", "src": "{{uploadFilePath}}"}, {"key": "namespace", "type": "text", "value": "{{namespace}}"}]},
            "url": "{{baseUrl}}/ingest/upload"
          }
        },
        {
          "name": "Ingestion Upload Alias",
          "request": {
            "method": "POST",
            "body": {"mode": "formdata", "formdata": [{"key": "file", "type": "file", "src": "{{uploadFilePath}}"}, {"key": "namespace", "type": "text", "value": "{{namespace}}"}]},
            "url": "{{baseUrl}}/ingestion/upload"
          }
        },
        {
          "name": "Vectors Delete Doc",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"doc_id\": \"{{doc_id}}\"\n}"},
            "url": "{{baseUrl}}/vectors/delete-doc"
          }
        },
        {
          "name": "Retrieval Query",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"query\": \"payment terms\",\n  \"top_k\": 3,\n  \"rerank\": true\n}"},
            "url": "{{baseUrl}}/retrieval/query"
          }
        }
      ]
    },
    {
      "name": "V1 Namespaces",
      "item": [
        {"name": "List Namespaces", "request": {"method": "GET", "url": "{{baseUrl}}/v1/namespaces"}},
        {
          "name": "Create Namespace",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Idempotency-Key", "value": "ns-create-1"}],
            "body": {"mode": "raw", "raw": "{\n  \"namespace\": \"postman_ns\",\n  \"defaults\": {\"top_k\": 5}\n}"},
            "url": "{{baseUrl}}/v1/namespaces"
          }
        },
        {"name": "Delete Namespace Dry Run", "request": {"method": "DELETE", "url": "{{baseUrl}}/v1/namespaces/postman_ns?dry_run=true"}},
        {"name": "Delete Namespace", "request": {"method": "DELETE", "url": "{{baseUrl}}/v1/namespaces/postman_ns"}}
      ]
    },
    {
      "name": "V1 Documents",
      "item": [
        {"name": "List Documents", "request": {"method": "GET", "url": "{{baseUrl}}/v1/documents?limit=20"}},
        {"name": "Get Document", "request": {"method": "GET", "url": "{{baseUrl}}/v1/documents/{{namespace}}/{{doc_id}}"}},
        {"name": "Delete Document Soft", "request": {"method": "DELETE", "url": "{{baseUrl}}/v1/documents/{{namespace}}/{{doc_id}}"}},
        {"name": "Delete Document Hard", "request": {"method": "DELETE", "url": "{{baseUrl}}/v1/documents/{{namespace}}/{{doc_id}}?hard_delete=true"}},
        {
          "name": "Bulk Delete Documents",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"namespace\": \"{{namespace}}\",\n  \"doc_ids\": [\"{{doc_id}}\"],\n  \"hard_delete\": false\n}"},
            "url": "{{baseUrl}}/v1/documents:bulk_delete"
          }
        }
      ]
    },
    {
      "name": "V1 Ingestions",
      "item": [
        {
          "name": "Create Ingestion (Folder)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"namespace\": \"{{namespace}}\",\n  \"source_type\": \"folder\",\n  \"source_spec\": {\n    \"path\": \".\",\n    \"dry_run\": true\n  }\n}"},
            "url": "{{baseUrl}}/v1/ingestions"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["var b=pm.response.json(); if (b && b.ingestion_id) { pm.environment.set('ingestion_id', b.ingestion_id); }"]}}]
        },
        {
          "name": "Create Ingestion (Repo)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"namespace\": \"{{namespace}}\",\n  \"source_type\": \"repo\",\n  \"source_spec\": {\n    \"repo\": \"{{repo_url}}\",\n    \"revision\": \"\",\n    \"dry_run\": true\n  }\n}"},
            "url": "{{baseUrl}}/v1/ingestions"
          }
        },
        {
          "name": "Create Ingestion (Upload)",
          "request": {
            "method": "POST",
            "body": {"mode": "formdata", "formdata": [{"key": "file", "type": "file", "src": "{{uploadFilePath}}"}, {"key": "namespace", "type": "text", "value": "{{namespace}}"}]},
            "url": "{{baseUrl}}/v1/ingestions/upload"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["var b=pm.response.json(); if (b && b.ingestion_id) { pm.environment.set('ingestion_id', b.ingestion_id); }"]}}]
        },
        {"name": "List Ingestions", "request": {"method": "GET", "url": "{{baseUrl}}/v1/ingestions"}},
        {"name": "Get Ingestion", "request": {"method": "GET", "url": "{{baseUrl}}/v1/ingestions/{{ingestion_id}}"}},
        {"name": "Get Ingestion Events", "request": {"method": "GET", "url": "{{baseUrl}}/v1/ingestions/{{ingestion_id}}/events"}},
        {"name": "Cancel Ingestion", "request": {"method": "POST", "url": "{{baseUrl}}/v1/ingestions/{{ingestion_id}}/cancel"}}
      ]
    },
    {
      "name": "V1 Query + Runs",
      "item": [
        {
          "name": "Query",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"query\": \"{{question}}\",\n  \"top_k\": {{top_k}},\n  \"rerank\": true\n}"},
            "url": "{{baseUrl}}/v1/query"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["var b=pm.response.json(); if (b && b.run_id) { pm.environment.set('run_id', b.run_id); } if (b && b.trace_id) { pm.environment.set('trace_id', b.trace_id); }"]}}]
        },
        {
          "name": "Query Stream SSE",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "text/event-stream"}],
            "body": {"mode": "raw", "raw": "{\n  \"query\": \"{{question}}\",\n  \"top_k\": {{top_k}},\n  \"rerank\": true\n}"},
            "url": "{{baseUrl}}/v1/query/stream"
          }
        },
        {"name": "Get Run", "request": {"method": "GET", "url": "{{baseUrl}}/v1/runs/{{run_id}}"}},
        {"name": "Get Run Steps", "request": {"method": "GET", "url": "{{baseUrl}}/v1/runs/{{run_id}}/steps"}},
        {"name": "Get Run Events", "request": {"method": "GET", "url": "{{baseUrl}}/v1/runs/{{run_id}}/events"}},
        {"name": "Replay Run SSE", "request": {"method": "GET", "header": [{"key": "Accept", "value": "text/event-stream"}], "url": "{{baseUrl}}/v1/runs/{{run_id}}/replay"}}
      ]
    },
    {
      "name": "V1 Retrieve + Rerank",
      "item": [
        {
          "name": "Retrieve",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"query\": \"{{question}}\",\n  \"top_k\": {{top_k}},\n  \"rerank\": true\n}"},
            "url": "{{baseUrl}}/v1/retrieve"
          }
        },
        {
          "name": "Rerank Candidates",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"query\": \"payment\",\n  \"top_k\": 2,\n  \"candidates\": [\n    {\"chunk_id\":\"a1\",\"doc_id\":\"doc-a\",\"text\":\"payment due in 14 days\",\"dense_score\":0.2,\"bm25_score\":0.3},\n    {\"chunk_id\":\"b1\",\"doc_id\":\"doc-b\",\"text\":\"support contact\",\"dense_score\":0.1,\"bm25_score\":0.1}\n  ]\n}"},
            "url": "{{baseUrl}}/v1/rerank"
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000"},
    {"key": "question", "value": "Summarize indexed documents"},
    {"key": "top_k", "value": "3"},
    {"key": "namespace", "value": "default"},
    {"key": "doc_id", "value": "postman_doc_legacy_chunks"},
    {"key": "uploadFilePath", "value": ""},
    {"key": "repo_url", "value": "https://github.com/octocat/Hello-World.git"},
    {"key": "ingestion_id", "value": ""},
    {"key": "run_id", "value": ""},
    {"key": "trace_id", "value": ""}
  ]
}
